// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Users table for auth
model User {
  id           String      @id @default(uuid()) @db.Uuid
  email        String      @unique
  passwordHash String      @map("password_hash")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  character    Character?

  @@map("users")
}

// Characters
model Character {
  id                          String               @id @default(uuid()) @db.Uuid
  userId                      String               @unique @map("user_id") @db.Uuid
  name                        String
  originId                    String               @map("origin_id")
  characterType               String?              @map("character_type")
  level                       Int                  @default(1)
  currentXp                   Int                  @default(0) @map("current_xp")
  currentHp                   Int                  @default(100) @map("current_hp")
  maxHp                       Int                  @default(100) @map("max_hp")
  currentEnergy               Int                  @default(100) @map("current_energy")
  maxEnergy                   Int                  @default(100) @map("max_energy")
  money                       Int                  @default(0)
  pendingLevelUpAttributePick Boolean              @default(false) @map("pending_levelup_attribute_pick")
  currentDistrict             String               @default("downtown") @map("current_district")
  lastEnergyReset             DateTime             @default(now()) @map("last_energy_reset")
  lastEnergyRegenAt           DateTime?            @map("last_energy_regen_at")
  leverageControl             Int                  @default(0) @map("leverage_control")
  leverageStability           Int                  @default(0) @map("leverage_stability")
  leveragePosition            Int                  @default(0) @map("leverage_position")
  actionCounter               Int                  @default(0) @map("action_counter")
  createdAt                   DateTime             @default(now()) @map("created_at")
  updatedAt                   DateTime             @updatedAt @map("updated_at")

  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  attributes         CharacterAttribute[]
  powers             CharacterPower[]
  factionReputations FactionReputation[]
  inventoryItems     InventoryItem[]
  storyEvents        StoryEvent[]
  actionCooldowns    ActionCooldown[]
  goals              CharacterGoal[]
  consequenceThreads ConsequenceThread[]
  knownNPCs          CharacterNPC[]
  rival              Rival?

  @@map("characters")
}

// Character Attributes (strength, intelligence, etc.)
model CharacterAttribute {
  id           String    @id @default(uuid()) @db.Uuid
  characterId  String    @map("character_id") @db.Uuid
  attributeId  String    @map("attribute_id")
  currentValue Int       @map("current_value")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, attributeId])
  @@index([characterId])
  @@map("character_attributes")
}

// Character Powers
model CharacterPower {
  id           String    @id @default(uuid()) @db.Uuid
  characterId  String    @map("character_id") @db.Uuid
  powerId      String    @map("power_id")
  currentLevel Int       @default(1) @map("current_level")
  currentXp    Int       @default(0) @map("current_xp")
  timesUsed    Int       @default(0) @map("times_used")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, powerId])
  @@index([characterId])
  @@map("character_powers")
}

// Faction Reputations
model FactionReputation {
  id          String    @id @default(uuid()) @db.Uuid
  characterId String    @map("character_id") @db.Uuid
  factionId   String    @map("faction_id")
  reputation  Int       @default(0)

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, factionId])
  @@index([characterId])
  @@map("faction_reputations")
}

// Inventory
model InventoryItem {
  id            String    @id @default(uuid()) @db.Uuid
  characterId   String    @map("character_id") @db.Uuid
  itemId        String    @map("item_id")
  quantity      Int       @default(1)
  isEquipped    Boolean   @default(false) @map("is_equipped")
  equipmentSlot String?   @map("equipment_slot")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, itemId])
  @@index([characterId])
  @@map("inventory_items")
}

// Story Events (for AI context and player history)
model StoryEvent {
  id              String    @id @default(uuid()) @db.Uuid
  characterId     String    @map("character_id") @db.Uuid
  eventType       String    @map("event_type")
  summary         String
  fullDescription String?   @map("full_description")
  narrativeWeight Int       @default(5) @map("narrative_weight")
  tags            String[]
  createdAt       DateTime  @default(now()) @map("created_at")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId])
  @@index([createdAt(sort: Desc)])
  @@map("story_events")
}

// Cached Encounters (for cost optimization)
model CachedEncounter {
  id            String    @id @default(uuid()) @db.Uuid
  encounterType String    @map("encounter_type")
  difficulty    Int
  factionContext String[] @map("faction_context")
  locationType  String?   @map("location_type")
  description   String
  choices       Json
  outcomes      Json
  timesUsed     Int       @default(0) @map("times_used")
  createdAt     DateTime  @default(now()) @map("created_at")
  lastUsedAt    DateTime? @map("last_used_at")

  @@index([encounterType, difficulty])
  @@map("cached_encounters")
}

// Action Cooldowns
model ActionCooldown {
  id          String    @id @default(uuid()) @db.Uuid
  characterId String    @map("character_id") @db.Uuid
  actionId    String    @map("action_id")
  expiresAt   DateTime  @map("expires_at")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, actionId])
  @@index([characterId])
  @@index([expiresAt])
  @@map("action_cooldowns")
}

// Character Goals (for gameplay objectives)
model CharacterGoal {
  id              String    @id @default(uuid()) @db.Uuid
  characterId     String    @map("character_id") @db.Uuid
  goalType        String    @map("goal_type")
  title           String
  description     String
  targetValue     Int       @map("target_value")
  currentProgress Int       @default(0) @map("current_progress")
  metadata        Json?
  xpReward        Int       @default(50) @map("xp_reward")
  isActive        Boolean   @default(true) @map("is_active")
  completedAt     DateTime? @map("completed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId])
  @@index([isActive])
  @@map("character_goals")
}

// Consequence Threads (short-term continuity between encounters)
model ConsequenceThread {
  id                    String    @id @default(uuid()) @db.Uuid
  characterId           String    @map("character_id") @db.Uuid
  isActive              Boolean   @default(true) @map("is_active")
  type                  String    // 'retaliation' | 'recognition' | 'escalation' | 'callback'
  triggerActionId       String?   @map("trigger_action_id")
  triggerLocationType   String?   @map("trigger_location_type")
  triggerFactionId      String?   @map("trigger_faction_id")
  title                 String
  summary               String
  injectionText         String    @map("injection_text")
  expiresInActions      Int       @default(4) @map("expires_in_actions")
  actionsElapsed        Int       @default(0) @map("actions_elapsed")
  createdFromEncounterId String?  @map("created_from_encounter_id")
  npcId                 String?   @map("npc_id")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId])
  @@index([characterId, isActive])
  @@map("consequence_threads")
}

// Character-NPC relationship tracking
model CharacterNPC {
  id          String    @id @default(uuid()) @db.Uuid
  characterId String    @map("character_id") @db.Uuid
  npcId       String    @map("npc_id")
  familiarity Int       @default(0)
  disposition Int       @default(0)
  lastSeenAt  DateTime? @map("last_seen_at")
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, npcId])
  @@index([characterId])
  @@map("character_npcs")
}

// Rival (one per character, unlocked at level 5)
model Rival {
  id              String    @id @default(uuid()) @db.Uuid
  characterId     String    @unique @map("character_id") @db.Uuid
  name            String
  role            String    // 'hero' | 'villain'
  personality     String    // 'brute' | 'tactician' | 'zealot' | 'sadist' | 'hunter'
  level           Int
  attributes      Json      // Record<string, number>
  powers          Json      // { powerId, currentLevel, currentXp, timesUsed }[]
  hostility       Int       @default(0)
  notoriety       Int       @default(0)
  lastEncounterAt DateTime? @map("last_encounter_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("rivals")
}

// Encounter telemetry for balance + behavior analysis
model EncounterRun {
  id                    String    @id @default(uuid()) @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at")

  // Core identifiers
  characterId           String    @map("character_id") @db.Uuid
  userId                String?   @map("user_id") @db.Uuid
  actionType            String    @map("action_type")
  encounterId           String?   @map("encounter_id")
  seedId                String?   @map("seed_id") @db.Uuid

  // Encounter context
  encounterType         String    @map("encounter_type")
  difficultyTier        Int       @map("difficulty_tier")
  district              String?
  tags                  Json?     // string[]
  factions              Json?     // string[]

  // NPC / Rival / Opponent
  npcId                 String?   @map("npc_id")
  npcName               String?   @map("npc_name")
  rivalId               String?   @map("rival_id") @db.Uuid
  rivalName             String?   @map("rival_name")
  opponentKind          String?   @map("opponent_kind") // "rival" | "npc" | "archetype"
  opponentName          String?   @map("opponent_name")
  opponentArchetype     String?   @map("opponent_archetype")
  opponentThreatTier    Int?      @map("opponent_threat_tier")

  // Prep + Focus
  prepType              String?   @map("prep_type") // "momentum" | "intel" | "power"
  prepPowerId           String?   @map("prep_power_id")
  focusMode             String?   @map("focus_mode") // "power" | "awareness" | "aggression" | "defense"
  focusModifier         Int?      @map("focus_modifier")

  // Gambit (choice consequence roll)
  gambitIntent          String?   @map("gambit_intent") // "control" | "stability" | "position"
  gambitOutcome         String?   @map("gambit_outcome") // "clean" | "complication" | "backfire"
  gambitRoll            Int?      @map("gambit_roll") // 1-100
  gambitEffects         Json?     @map("gambit_effects") // [{target,resource,delta}]

  // Leverage tracking (JSON for compactness: {c,s,p})
  leverageDbStart       Json?     @map("leverage_db_start")
  leverageGained        Json?     @map("leverage_gained")
  leverageSpent         Json?     @map("leverage_spent")
  leverageFinal         Json?     @map("leverage_final")
  actionCounterBefore   Int?      @map("action_counter_before")
  actionCounterAfter    Int?      @map("action_counter_after")
  decayApplied          Boolean?  @map("decay_applied")
  decayRemovedType      String?   @map("decay_removed_type")

  // Conflict timeline (JSON array of turn entries)
  turns                 Json?     // [{turnIndex,playerMove,opponentMove,leverageSpent,resourcesBefore,resourcesAfter}]

  // Outcome + rewards
  conflictResult        String?   @map("conflict_result") // "victory" | "defeat" | "stalemate"
  turnsUsed             Int?      @map("turns_used")
  finalResources        Json?     @map("final_resources") // {player:{c,s,p},opponent:{c,s,p}}
  rewardSummary         Json?     @map("reward_summary") // {xpGained,hpLoss,prepEnergyCost,factionChangesCount,...}
  isConflictDriven      Boolean   @default(true) @map("is_conflict_driven")

  // Performance (optional)
  executeMs             Int?      @map("execute_ms")
  resolveMs             Int?      @map("resolve_ms")

  @@index([characterId, createdAt])
  @@index([encounterType])
  @@index([difficultyTier])
  @@map("encounter_runs")
}
